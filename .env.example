# Barganha — variáveis de ambiente (modelo).
# Copie para `.env` e preencha. NUNCA commitar `.env` com valores reais.
# O `.gitignore` já bloqueia `.env` e `.env.*` (exceto este arquivo).

# Ambiente
NODE_ENV=development

# Backend (servidor de ingestão — C2) -------------------------------------
# Porta do servidor HTTP (Fastify). Padrão: 3000.
PORT=3000

# Operação / Lançamento (C10) ---------------------------------------------
# Lançamento faseado: UFs atendidas AGORA (CSV). Vazio → padrão RJ,SP.
# Habilitar um estado novo = adicionar aqui e rodar o reprocessamento
# retroativo (C2.5) para liberar os cupons represados daquela UF.
UFS_HABILITADAS=RJ,SP
# Atrás de proxy/load balancer, ligue para o rate-limit (C9.3.2) enxergar o IP
# real do cliente via X-Forwarded-For. Em dev (sem proxy), mantenha false.
TRUST_PROXY=false

# Expansão / Curadoria (C11) ----------------------------------------------
# Tokens dos endpoints privilegiados de curadoria (CSV): moderar lançamento
# manual de gôndola (C11.3) e enriquecer produtos (C11.5). VAZIO = curadoria
# desabilitada (fail-closed): nenhum desses endpoints autoriza nada.
CURADORIA_TOKENS=

# Banco de dados (Postgres / Supabase) ------------------------------------
# Conexão local do Supabase CLI (`supabase start`) — porta padrão 54322.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Projeto Supabase (dev). Pegue em: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no backend. Nunca expor no app/cliente.
SUPABASE_SERVICE_ROLE_KEY=

# App store / EAS Submit iOS (C11.2) --------------------------------------
# Usados por `eas submit` (app/eas.json → submit.production.ios). Não são
# segredos do backend; ficam no ambiente de CI/CD que publica o app.
APPLE_ID=
ASC_APP_ID=
APPLE_TEAM_ID=
