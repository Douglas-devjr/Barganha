# Barganha — variáveis de ambiente (modelo).
# Copie para `.env` e preencha. NUNCA commitar `.env` com valores reais.
# O `.gitignore` já bloqueia `.env` e `.env.*` (exceto este arquivo).

# Ambiente
NODE_ENV=development

# Backend (servidor de ingestão — C2) -------------------------------------
# Porta do servidor HTTP (Fastify). Padrão: 3000.
PORT=3000

# Operação / Lançamento (C10) ---------------------------------------------
# Lançamento faseado: UFs atendidas AGORA (CSV). Vazio → padrão RJ,SP.
# Habilitar um estado novo = adicionar aqui e rodar o reprocessamento
# retroativo (C2.5) para liberar os cupons represados daquela UF.
UFS_HABILITADAS=RJ,SP
# Atrás de proxy/load balancer, ligue para o rate-limit (C9.3.2) enxergar o IP
# real do cliente via X-Forwarded-For. Em dev (sem proxy), mantenha false.
TRUST_PROXY=false
# Job em lote de recálculo de `preco_estatistica` (C3.1/C10 — rede de segurança
# do recálculo inline da ingestão). Janela de retrovisão em minutos: recalcula
# os produtos com observação inserida nesse intervalo. `0` = recálculo completo.
# Usado por `npm run job:recalculo` (agendado em .github/workflows). Padrão: 180.
RECALCULO_LOOKBACK_MINUTES=180

# Expansão / Curadoria (C11) ----------------------------------------------
# Tokens dos endpoints privilegiados de curadoria (CSV): moderar lançamento
# manual de gôndola (C11.3) e enriquecer produtos (C11.5). VAZIO = curadoria
# desabilitada (fail-closed): nenhum desses endpoints autoriza nada.
CURADORIA_TOKENS=
# Enriquecimento AUTOMÁTICO via catálogo VTEX (C11.5 — job:enriquecer).
# JSON array de redes; VAZIO = feature desligada. Remover uma rede (ex.: a
# pedido dela) é editar aqui — sem deploy. Só EXIBIÇÃO (nome/marca/foto/
# categoria); preço anunciado NUNCA entra no pool (C12.4 é camada separada).
#
# O enriquecimento é GLOBAL por EAN: um produto tem o mesmo EAN/nome em
# qualquer rede, então basta UMA rede grande conhecer o EAN. As redes abaixo
# foram validadas como VTEX de catálogo público aberto (jul/2026). Ver a matriz
# de plataformas por mercado em docs/17-fontes-catalogo.md.
# REDES_VTEX=[{"id":"zonasul","nome":"Zona Sul","dominio":"www.zonasul.com.br"},{"id":"prezunic","nome":"Prezunic","dominio":"www.prezunic.com.br"},{"id":"mambo","nome":"Mambo","dominio":"www.mambo.com.br"},{"id":"hortifruti","nome":"Hortifruti","dominio":"www.hortifruti.com.br"}]
REDES_VTEX=

# Banco de dados (Postgres / Supabase) ------------------------------------
# Conexão local do Supabase CLI (`supabase start`) — porta padrão 54322.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Projeto Supabase (dev). Pegue em: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no backend. Nunca expor no app/cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Observabilidade (C10.2) -------------------------------------------------
# Webhook para o alerta de parsing degradado (job:alerta-parsing, cron horário).
# Aceita URL de Discord ou Slack — o corpo enviado serve aos dois. Vazio: o job
# apenas registra a linha `error` no log da execução, sem avisar ninguém.
ALERTA_WEBHOOK_URL=

# App store / EAS Submit iOS (C11.2) --------------------------------------
# Usados por `eas submit` (app/eas.json → submit.production.ios). Não são
# segredos do backend; ficam no ambiente de CI/CD que publica o app.
APPLE_ID=
ASC_APP_ID=
APPLE_TEAM_ID=
