# Barganha — variáveis de ambiente (modelo).
# Copie para `.env` e preencha. NUNCA commitar `.env` com valores reais.
# O `.gitignore` já bloqueia `.env` e `.env.*` (exceto este arquivo).

# Ambiente
NODE_ENV=development

# Banco de dados (Postgres / Supabase) ------------------------------------
# Conexão local do Supabase CLI (`supabase start`) — porta padrão 54322.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Projeto Supabase (dev). Pegue em: Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no backend. Nunca expor no app/cliente.
SUPABASE_SERVICE_ROLE_KEY=
