{
  "expo": {
    "name": "Barganha",
    "slug": "barganha",
    "scheme": "barganha",
    "owner": "arkasher",
    "version": "0.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B1B19",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "updates": {
      "url": "https://u.expo.dev/14a2217a-139e-426b-b34e-5c026f519d70",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barganha.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Barganha"
      }
    },
    "android": {
      "package": "com.barganha.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B1B19"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Barganha usa a câmera para ler o QR Code da nota fiscal."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Barganha usa sua localização só para detectar sua região e comparar preços dos mercados por perto. Sua posição não é salva nem enviada.",
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "eas": {
        "projectId": "14a2217a-139e-426b-b34e-5c026f519d70"
      }
    }
  }
}
