# C4.3.1 — Configuração do app (Expo embute `EXPO_PUBLIC_*` no bundle do build).
# Copie para `.env` e preencha. NUNCA comite o `.env` com valores reais.

# URL base do backend.
# DEV com celular físico: DEIXE VAZIO — o app deriva o IP da máquina do host do
# Metro e acompanha o DHCP sozinho (nada a editar quando o IP muda). Preencha só
# para backend remoto/produção. Porta diferente de 3000? Use EXPO_PUBLIC_API_PORT.
EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_API_PORT=3000

# Supabase Auth (login). A ANON KEY é pública por design (protegida por RLS);
# a SERVICE ROLE KEY é só do backend e NUNCA entra no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Página-ponte HTTPS para onde os LINKS DE E-MAIL de auth redirecionam
# (confirmar cadastro, recuperar senha). Deixe VAZIO para usar o default do
# GitHub Pages (site/auth-callback.html). Preencha só ao migrar para domínio
# próprio/App Links. Precisa estar nas Redirect URLs do Supabase (docs/19 §5).
# EXPO_PUBLIC_AUTH_EMAIL_REDIRECT=
