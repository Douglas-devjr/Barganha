# C4.3.1 — Configuração do app (Expo embute `EXPO_PUBLIC_*` no bundle do build).
# Copie para `.env` e preencha. NUNCA comite o `.env` com valores reais.

# URL base do backend (em device físico, use o IP da máquina, não localhost).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase Auth (login). A ANON KEY é pública por design (protegida por RLS);
# a SERVICE ROLE KEY é só do backend e NUNCA entra no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
