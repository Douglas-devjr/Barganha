{
  "name": "@barganha/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "job:recalculo": "node --env-file-if-exists=../.env --import tsx src/jobs/recalculo-estatistica.ts",
    "job:republicar": "node --env-file-if-exists=../.env --import tsx src/jobs/republicar-pool.ts",
    "job:enriquecer": "node --env-file-if-exists=../.env --import tsx src/jobs/enriquecer-catalogo.ts",
    "job:alerta-parsing": "node --env-file-if-exists=../.env --import tsx src/jobs/alerta-parsing.ts",
    "job:alerta-preco": "node --env-file-if-exists=../.env --import tsx src/jobs/alerta-preco.ts",
    "job:alerta-anomalias": "node --env-file-if-exists=../.env --import tsx src/jobs/alerta-anomalias.ts",
    "job:purga-inativos": "node --env-file-if-exists=../.env --import tsx src/jobs/purga-inatividade.ts"
  },
  "dependencies": {
    "@barganha/shared": "*",
    "@supabase/supabase-js": "^2.108.2",
    "expo-server-sdk": "^7.0.0",
    "fastify": "^5.8.5",
    "node-html-parser": "^8.0.3",
    "pino": "^10.3.1",
    "tsx": "^4.22.4"
  }
}
